DEEPSEEK_API_KEY=your_deepseek_api_key
SERPER_API_KEY=your_serper_api_key
MODEL_NAME=deepseek-v4-flash
MODEL_CONTEXT_WINDOW_TOKENS=1000000
CONTEXT_INPUT_BUDGET_TOKENS=60000
MAX_OUTPUT_TOKENS=4096
CONTEXT_SAFETY_TOKENS=4096
CONTEXT_SUMMARY_TOKENS=2048
CONTEXT_RECENT_TURNS=4
# Default graph has at most 32 node executions; one extra slot permits termination.
AGENT_MAX_GRAPH_STEPS=35
AGENT_MAX_RETRIEVAL_RETRIES=1
AGENT_MAX_ATTEMPTS=2
AGENT_RETRY_BASE_SECONDS=0.5
AGENT_EXECUTION_TIMEOUT_SECONDS=120
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_TRUST_ENV=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MAX_PDF_UPLOAD_BYTES=26214400
WORKSPACE_DIR=.rag_workspace
FRONTEND_URL=http://127.0.0.1:8501

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-studio

# Hybrid PDF retrieval and local cross-encoder reranking
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_FALLBACK=true

# PDF text extraction: auto, always, or off (requires uv sync --extra ocr)
PDF_OCR_MODE=auto
PDF_OCR_LANG=ch
PDF_OCR_DEVICE=cpu
PDF_OCR_DPI=200
PDF_OCR_MIN_TEXT_CHARS=40
PDF_OCR_MIN_CONFIDENCE=0.5
PADDLE_PDX_CACHE_HOME=.runtime/paddle-cache

# Multi-document registry and bounded candidate recall (one global reranker)
WORKSPACE_MAX_DOCUMENTS=20
WORKSPACE_RETRIEVAL_PER_DOC_K=8
WORKSPACE_RETRIEVAL_GLOBAL_K=5
WORKSPACE_RETRIEVAL_CONCURRENCY=4
WORKSPACE_RETRIEVAL_TIMEOUT_SECONDS=30

# Sequential planner; simple questions bypass planning
PLANNER_ENABLED=true
PLANNER_MAX_STEPS=6
PLANNER_MAX_ITERATIONS=8
PLANNER_MAX_REPLAN=1

# At most two intent-preserving rewrites and one answer revision
SELF_CORRECT_RAG_ENABLED=true
RETRIEVAL_REWRITE_MAX=2
GROUNDING_CHECK_ENABLED=true
ANSWER_REVISION_MAX=1

# Keep node timing/metadata traces without uploading document/message bodies
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Phase 3: continuity, constrained analysis and durable tasks
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
MEMORY_MAX_ITEMS=6
MEMORY_TOKEN_BUDGET=1200
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_MIN_IMPORTANCE=0.50
MEMORY_DEDUP_SIMILARITY=0.94
DATA_ANALYSIS_ENABLED=true
TOOL_REGISTRY_ENABLED=true
MCP_ENABLED=true
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_CALL_TIMEOUT_SECONDS=30
MCP_SERVERS_FILE=
TOOL_APPROVAL_ENABLED=true
TOOL_AUTO_APPROVE_READ=true
TOOL_APPROVE_WRITES=true
TOOL_APPROVE_DELETES=true
GITHUB_MCP_ENABLED=false
GITHUB_MCP_READ_ONLY=true
GITHUB_MCP_LOCKDOWN=true
GITHUB_ALLOWED_REPOSITORIES=
MCP_GITHUB_TOOLSETS=context,repos,issues,pull_requests
MCP_GITHUB_TOOL_ALLOWLIST=
GITHUB_PERSONAL_ACCESS_TOKEN=
DATASET_MAX_FILE_MB=50
ANALYSIS_TIMEOUT_SECONDS=30
ANALYSIS_MAX_CODE_CHARS=12000
ANALYSIS_MAX_OUTPUT_CHARS=20000
ANALYSIS_MAX_ARTIFACT_MB=20
ANALYSIS_MAX_ARTIFACTS=10
ANALYSIS_CODE_REPAIR_MAX=1
TASK_SYSTEM_ENABLED=true
TASK_MAX_STEPS=10
TASK_MAX_STEP_ATTEMPTS=2

# Phase 5A: bounded supervisor-worker orchestration
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_DELEGATIONS=8
MULTI_AGENT_MAX_PARALLEL=3
MULTI_AGENT_MAX_DEPTH=1
MULTI_AGENT_REVIEW_ENABLED=true
MULTI_AGENT_REVIEW_REQUIRED=false
MULTI_AGENT_REVIEW_MAX_ROUNDS=1
MULTI_AGENT_REDELEGATION_MAX=2
MULTI_AGENT_CONTEXT_TOKEN_BUDGET=8000
MULTI_AGENT_SUPERVISOR_MAX_LLM_CALLS=10
MULTI_AGENT_AGENT_TIMEOUT_SECONDS=90
# Phase 5A.5: selective routing, task-local cache and aggregate budgets.
MULTI_AGENT_EFFICIENCY_ENABLED=true
MULTI_AGENT_COST_AWARE_ROUTING=true
MULTI_AGENT_REVIEW_POLICY=risk_based
MULTI_AGENT_DELEGATION_CACHE=true
MULTI_AGENT_DUPLICATE_DETECTION=true
# 24 attempts allow finalization and one bounded repair beyond the observed 19-call baseline.
MULTI_AGENT_MAX_LLM_CALLS=24
MULTI_AGENT_MAX_TOOL_CALLS=12
MULTI_AGENT_MAX_TOTAL_TOKENS=
MULTI_AGENT_MAX_WALL_TIME_SECONDS=300
MULTI_AGENT_SOFT_BUDGET_RATIO=0.80
RESEARCH_AGENT_MAX_ITERATIONS=6
RESEARCH_AGENT_MAX_TOOL_CALLS=8
DATA_AGENT_MAX_ITERATIONS=4
DATA_AGENT_MAX_TOOL_CALLS=4
CODING_AGENT_MAX_ITERATIONS=5
CODING_AGENT_MAX_TOOL_CALLS=6
REVIEWER_AGENT_MAX_ITERATIONS=2
# Phase 5B-1: reversible database and execution backends
DATABASE_BACKEND=sqlite
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
TASK_EXECUTION_MODE=inline
TASK_QUEUE_ENABLED=false
WORKER_CONCURRENCY=2
WORKER_QUEUE=agent
WORKER_GRACEFUL_SHUTDOWN_SECONDS=120
WORKER_MAX_RETRIES=2
WORKER_STALLED_JOB_RECOVERY=true

# Phase 5B-2: SQLite/inline defaults remain local development only.
APP_ENV=development
AUTH_ENABLED=false
ALLOW_INSECURE_PRODUCTION_AUTH=false
AUTH_ALLOW_REGISTRATION=true
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=agentic-rag-studio
AUTH_JWT_AUDIENCE=agentic-rag-api
AUTH_ACCESS_TOKEN_MINUTES=20
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8501
TRUSTED_HOSTS=localhost,127.0.0.1,api
LOG_FORMAT=text
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-rag-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Compose-only variables. Keep real values outside version control/build context.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=agentic_rag
APP_IMAGE=agentic-rag-studio:local
INSTALL_OCR=false
GRAFANA_ADMIN_USER=operator
GRAFANA_ADMIN_PASSWORD=
